@page "/"
@inject ITranslationService TranslationService
@inject IJSRuntime JS
@inject AppConfig AppCfg
@inject IDialogService DialogService
@inject LanguageService LanguageService

<div class="tg-layout" style="display:flex; flex-direction:column; height:100vh; overflow:hidden;">

    @* ── 標題列 ── *@
    <div class="d-flex align-center justify-space-between px-4 pt-3 pb-2" style="flex-shrink:0;">
        <MudText Typo="Typo.h6" Style="font-weight:600;">
            @if (!string.IsNullOrWhiteSpace(AppCfg.AppLogoUrl))
            {
                <img src="@AppCfg.AppLogoUrl" alt="logo"
                     style="height:24px; vertical-align:middle; margin-right:6px;" />
            }
            @AppCfg.AppTitle
        </MudText>
        <div class="d-flex align-center gap-1">
            <MudBadge Content="@_customGlossary.Count" Color="Color.Primary"
                      Overlap="true" Visible="@(_customGlossary.Count > 0)">
                <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz"
                               title="設定與術語對照表"
                               OnClick="OpenGlossary" />
            </MudBadge>
            <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           title="@(IsDarkMode ? "切換亮色模式" : "切換深色模式")"
                           OnClick="() => ToggleTheme?.Invoke()" />
        </div>
    </div>

    @* 語系選擇器列（置頂：啟用且語系清單已載入時展示） *@
    @if (AppCfg.LanguageSelectorEnabled && _languages.Count > 0)
    {
        <div style="flex-shrink:0; display:flex; justify-content:center; padding:0 16px 4px;">
            <div style="width:fit-content; max-width:100%;">
                <div style="display:flex; align-items:flex-end; justify-content:center; gap:10px; flex-wrap:wrap;">
                    <div style="width:clamp(180px, 18vw, 260px);">
                        <MudText Typo="Typo.caption" Style="display:block; margin:0 0 2px 2px;">Source Lang：</MudText>
                        <LanguageSelector ShowAuto="true"
                                          Languages="_languages"
                                          Value="@_sourceLang"
                                          ValueChanged="OnSourceLangChanged"
                                          Disabled="@_isLangLoading"
                                          Label=""
                                          Placeholder="自動偵測"
                                          SelectStyle="width:100%;" />
                    </div>
                    <div style="align-self:flex-end; display:flex; align-items:center; height:36px; margin-bottom:2px;">
                        <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                                       title="互換語系"
                                       OnClick="SwapLanguages"
                                       Size="Size.Small"
                                       Disabled="@(_isLangLoading || !AppCfg.LanguageSelectorEnabled)" />
                    </div>
                    <div style="width:clamp(180px, 18vw, 260px);">
                        <MudText Typo="Typo.caption" Style="display:block; margin:0 0 2px 2px;">Targat Lang：</MudText>
                        <LanguageSelector ShowAuto="true"
                                          Languages="_languages"
                                          Value="@_targetLang"
                                          ValueChanged="OnTargetLangChanged"
                                          Disabled="@_isLangLoading"
                                          Label=""
                                          Placeholder="自動偵測"
                                          SelectStyle="width:100%;" />
                    </div>
                </div>
                @* FR-008: 相同語系警告 *@
                @if (_sourceLang != null && _targetLang != null && _sourceLang == _targetLang)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Style="margin-top:4px;">
                        原語系與目的語系相同，翻譯結果可能不準確。
                    </MudAlert>
                }
            </div>
        </div>
    }

    @* ── 對話區（可捲動，填滿中間） ── *@
    <div id="chat-area" style="flex:1; overflow-y:auto; padding:8px 16px;">
        @if (_history.Count == 0)
        {
            <div style="height:100%; display:flex; align-items:center; justify-content:center;">
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-disabled);">
                    輸入文字後點擊「翻譯」，這裡會顯示翻譯結果
                </MudText>
            </div>
        }
        else
        {
            @foreach (var item in _history)
            {
                <div style="width:@(AppCfg.ContentWidthPercent)%; margin:0 auto;">
                @* 原文泡泡（右） *@
                <ChatBubble Text="@item.OriginalText"
                            IsUser="true"
                            Timestamp="@item.Timestamp" />
                @* 譯文泡泡（左） *@
                <ChatBubble Text="@(item.IsError ? (item.ErrorMessage ?? "翻譯失敗") : item.TranslatedText)"
                            IsUser="false"
                            IsError="@item.IsError"
                            IsPending="@item.IsPending"
                            Timestamp="@(item.CompletedAt != DateTime.MinValue ? item.CompletedAt : item.Timestamp)"
                            LangLabel="@(item.IsError || item.IsPending ? null : item.TargetLang)" />
                </div>
            }
        }
    </div>

    @* ── 輸入框（固定底部） ── *@
    <div style="flex-shrink:0; display:flex; justify-content:center; padding:12px 16px 20px;">
        <div style="width:@(AppCfg.ContentWidthPercent)%;">

            <TranslationInput IsSubmitting="@_isSubmitting"
                              OnSubmit="HandleSubmit"
                              OnCancel="HandleCancel"
                              MaxInputLength="@AppCfg.MaxInputLength" />
        </div>
    </div>

    @* ── Toast 通知 ── *@
    <ToastNotification Message="@_toastMessage"
                       Severity="@_toastSeverity"
                       Visible="@_toastVisible"
                       VisibleChanged="@((v) => _toastVisible = v)" />

</div>

@code {
    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }
    [CascadingParameter(Name = "ToggleTheme")] public Action? ToggleTheme { get; set; }

    private List<TranslationHistory> _history = new();
    private List<GlossaryEntry> _customGlossary = new();
    private bool _isSubmitting;
    private System.Threading.CancellationTokenSource? _streamCts;

    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private Severity _toastSeverity = Severity.Info;

    // T012: 語系選擇器狀態變數
    private string? _sourceLang;
    private string? _targetLang;
    private List<Language> _languages = new();
    private bool _isLangLoading;

    // 預設顯示為「自動偵測」
    private const string? DefaultAutoDetect = null;

    // T013: 載入語系清單
    protected override async Task OnInitializedAsync()
    {
        _isLangLoading = true;
        try
        {
            _languages = await LanguageService.GetLanguagesAsync();
            _sourceLang ??= DefaultAutoDetect;
            _targetLang ??= DefaultAutoDetect;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LanguageService] GET /api/languages 失敗：{ex.Message}");
            _languages = new List<Language>();
        }
        finally
        {
            _isLangLoading = false;
        }
    }

    // T015: FR-009 雙向自動切換邏輯（僅在使用者主動操作下拉選單時觸發）
    private void OnSourceLangChanged(string? val)
    {
        _sourceLang = val;
        if (val != null && (_targetLang == null || _targetLang == val))
        {
            _targetLang = val == "zh-TW" ? "en" : (val == "en" ? "zh-TW" : null);
        }
    }

    private void OnTargetLangChanged(string? val)
    {
        _targetLang = val;
        if (val != null && (_sourceLang == null || _sourceLang == val))
        {
            _sourceLang = val == "zh-TW" ? "en" : (val == "en" ? "zh-TW" : null);
        }
    }

    // T019: 互換語系（不觸發 FR-009）
    private void SwapLanguages()
    {
        (_sourceLang, _targetLang) = (_targetLang, _sourceLang);
    }

    private static string DetectTargetLang(string text) =>
        text.Any(c => c >= 0x4E00 && c <= 0x9FFF) ? "en" : "zh-TW";

    // T018: HandleSubmit 依語系選擇器啟用狀態決定是否傳入 sourceLang/targetLang
    private async Task HandleSubmit(string text)
    {
        string? sourceLang;
        string targetLang;

        if (AppCfg.LanguageSelectorEnabled)
        {
            // 語系選擇器啟用：使用使用者選擇值（null = 自動偵測）
            sourceLang = _sourceLang;
            targetLang = _targetLang ?? DetectTargetLang(text);
        }
        else
        {
            // 語系選擇器停用：維持現有自動偵測行為
            sourceLang = null;
            targetLang = DetectTargetLang(text);
        }

        var entry = new TranslationHistory
        {
            OriginalText = text,
            TargetLang = targetLang,
            IsPending = true,
        };
        _history.Add(entry);
        if (_history.Count > 50) _history.RemoveAt(0);

        _isSubmitting = true;
        StateHasChanged();
        await ScrollToBottom();

        _streamCts = new System.Threading.CancellationTokenSource();
        var req = new TranslationRequest
        {
            Text = text,
            SourceLang = sourceLang,
            TargetLang = targetLang,
            Stream = true,
            Glossary = _customGlossary.Count > 0 ? _customGlossary.ToList() : null,
        };
        string accumulated = string.Empty;
        string finalSource = string.Empty;
        bool hasError = false;
        string? errorMsg = null;

        try
        {
            await foreach (var token in TranslationService.TranslateStreamAsync(req, _streamCts.Token))
            {
                if (token.Error != null) { hasError = true; errorMsg = token.Error; break; }
                if (!token.Done) { accumulated += token.Token; }
                else { finalSource = token.SourceLang ?? string.Empty; break; } // done=true 於此結束
            }
        }
        catch (System.OperationCanceledException) when (_streamCts.IsCancellationRequested)
        {
            hasError = true;
            errorMsg = "翻譯已取消";
        }
        catch (System.OperationCanceledException)
        {
            // Blazor WASM 特性：串流結束時可能拋出 OCE，非使用者取消，實際結果已取得則保留
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMsg = $"連線錯誤：{ex.Message}";
        }

        entry.IsPending = false;
        entry.CompletedAt = DateTime.Now;
        entry.TranslatedText = hasError ? string.Empty : accumulated;
        entry.SourceLang = finalSource;
        entry.IsError = hasError;
        entry.ErrorMessage = errorMsg;
        _isSubmitting = false;

        if (hasError && errorMsg != null)
            ShowToast(errorMsg, Severity.Error);

        StateHasChanged();
        await ScrollToBottom();
    }

    private void HandleCancel() => _streamCts?.Cancel();

    private async Task OpenGlossary()
    {
        var parameters = new DialogParameters<GlossaryViewer>
        {
            { x => x.CustomEntries, _customGlossary.ToList() },
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GlossaryViewer>("術語對照表", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<GlossaryEntry> updated })
            _customGlossary = updated;
    }

    private void ShowToast(string msg, Severity severity = Severity.Info)
    {
        _toastMessage = msg;
        _toastSeverity = severity;
        _toastVisible = true;
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", "chat-area"); }
        catch { }
    }
}

