<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MudBlazor</id>
    <version>7.16.0</version>
    <authors>Garderoben, Henon and Contributors</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Nuget.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://mudblazor.com/</projectUrl>
    <description>A Blazor Component Library based on Material Design principles, focusing on ease of use. Written mainly in C# with minimal JavaScript, it allows .NET developers to easily understand and debug the code when needed.</description>
    <copyright>Copyright 2024 MudBlazor</copyright>
    <tags>Blazor, MudBlazor, Material, Material Design, Components, Blazor Components, Blazor Library</tags>
    <repository type="git" url="https://github.com/MudBlazor/MudBlazor" commit="9edfff2a6cc86463e301b3b8cd21ac60a6e93a9e" />
    <dependencies>
      <group targetFramework="net7.0">
        <dependency id="Microsoft.AspNetCore.Components" version="7.0.20" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Components.Web" version="7.0.20" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Localization" version="7.0.20" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.AspNetCore.Components" version="8.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Components.Web" version="8.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Localization" version="8.0.8" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>