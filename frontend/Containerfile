# ── 第一階段：dotnet build ─────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS builder

WORKDIR /src

# 複製 NuGet 套件快取（若已預先下載，可離線 build；目錄為空時 dotnet 自動上網）
COPY nuget-cache/ /nuget-packages/
ENV NUGET_PACKAGES=/nuget-packages

# 複製 csproj 與 global.json 並還原依賴（利用 layer cache）
COPY frontend.csproj global.json ./
RUN dotnet restore --source /nuget-packages

# 複製完整原始碼並發行
COPY . ./
RUN dotnet publish -c Release -o /publish --no-restore

# ── 第二階段：靜態檔案服務（nginx） ───────────────────────────────────────────
FROM nginx:alpine

# 複製 Blazor WASM 發行產物
COPY --from=builder /publish/wwwroot /usr/share/nginx/html

# nginx 配置：支援 SPA (Single Page Application) 路由
RUN printf 'server {\n\
    listen 80;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# 啟動腳本：用環境變數替換 appsettings.json 中的佔位符後再啟動 nginx
# BACKEND_URL 預設值：若未設定則回退至 localhost:8000
RUN printf '#!/bin/sh\n\
BACKEND_URL="${BACKEND_URL:-http://localhost:8000}"\n\
envsubst "${BACKEND_URL}" < /usr/share/nginx/html/appsettings.json \\\n\
    > /usr/share/nginx/html/appsettings.json.tmp \\\n\
  && mv /usr/share/nginx/html/appsettings.json.tmp \\\n\
        /usr/share/nginx/html/appsettings.json\n\
exec nginx -g "daemon off;"\n' > /docker-entrypoint-init.sh \
  && chmod +x /docker-entrypoint-init.sh

EXPOSE 80
CMD ["/docker-entrypoint-init.sh"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1
